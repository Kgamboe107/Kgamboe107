{
  "name": "ops-command-desk",
  "productName": "Ops Command Desk",
  "version": "1.12.0",
  "description": "Desktop command center for an operations manager: financials, operations, trading risk, marketing, research, and personnel across multiple businesses.",
  "author": "Gamboe Consulting",
  "homepage": "https://github.com/Kgamboe107/Kgamboe107",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "samples": "node scripts/write-samples.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gamboeconsulting.opsdesk",
    "productName": "Ops Command Desk",
    "copyright": "© Gamboe Consulting",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "preload.js", "server.js", "index.html", "css/**", "js/**", "vendor/**", "samples/**", "build/icon.png"],
    "artifactName": "Ops-Command-Desk-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ops Command Desk",
      "artifactName": "Ops-Command-Desk-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Ops Command Desk",
      "artifactName": "Ops-Command-Desk-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Gamboe Consulting <koen@gamboeconsulting.com>"
    }
  }
}
